# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Study-plan extraction candidates (scripts/extract-from-kopps.mjs). Generated
# inputs for human diff-and-merge, never the verified data. Kept out of
# src/data/ on purpose: useCourseModel.ts does `import(`@/data/${dataFile}`)`,
# so anything in that directory is pulled into the client bundle.
/extracted/
