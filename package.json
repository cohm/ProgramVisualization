{
  "name": "program-visualization",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "transition-review": "node scripts/transition-review.mjs",
    "validate-data": "node scripts/validate-data.mjs --cohorts",
    "extract-plan": "node scripts/extract-from-kopps.mjs",
    "size": "node scripts/split-size-chunks.mjs && size-limit",
    "extract-master-mapping": "node scripts/extract-master-mapping.mjs"
  },
  "size-limit": [
    {
      "name": "Application JS (brotlied)",
      "path": ".next/size-limit/app/*.js",
      "limit": "225 KB"
    },
    {
      "name": "Study-plan data chunks, loaded on demand (brotlied)",
      "path": ".next/size-limit/data/*.js",
      "limit": "450 KB"
    }
  ],
  "dependencies": {
    "@sparticuz/chromium": "^141.0.0",
    "d3-color": "^3.1.0",
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "next": "^16.3.6",
    "puppeteer-core": "^25.12.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@size-limit/file": "^14.1.0",
    "@tailwindcss/postcss": "^4",
    "@types/d3-color": "^3.1.3",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.6",
    "size-limit": "^14.1.0",
    "tailwindcss": "^4",
    "typescript": "^6"
  }
}
